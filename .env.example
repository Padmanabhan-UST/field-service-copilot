# Copy to .env and fill in. Never commit .env.
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
CHAT_DEPLOYMENT=<your-chat-deployment-name>
EMBEDDING_DEPLOYMENT=<your-embedding-deployment-name>
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=<endpoint>
IMAGE_DEPLOYMENT=<your-image-deployment-name>
FOUNDRY_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<foundry-resource>
AZURE_REGION=<region>